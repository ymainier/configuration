[alias]
	a = add
	b = branch
	c = commit -v
	ch = checkout
	chb = checkout -b
	d = diff
	f = fetch
	fp = fetch -p
	g = grep
	gf = ! git ls-files|grep --color=auto
	l = log -20 --graph --pretty=format:'%C(yellow)%h%C(cyan)%d%Creset %s %C(white)- %an, %ar%Creset'
	ll = log --graph --pretty=format:'%C(yellow)%h%C(cyan)%d%Creset %s %C(white)- %an, %ar%Creset'
	mod = !git merge origin/$(git symbolic-ref --short refs/remotes/origin/HEAD | sed s@^origin/@@)
	oops = commit --amend --no-edit
	pl = pull
	ps = push
	pss = "!git push --set-upstream origin $(git branch --show-current)"
	r = rebase
	rod = !git rebase origin/$(git symbolic-ref --short refs/remotes/origin/HEAD | sed s@^origin/@@)
	s = status -s
	sh = show
	st = stash
[color]
	ui = true
[core]
	editor = code --wait
	whitespace = -trailing-space
	# Machine-agnostic ignores; symlinked from this repo by setup.sh
	excludesFile = ~/.gitignore_global
[diff]
	# Use better, descriptive initials (c, i, w) instead of a/b.
	mnemonicPrefix = true
	# Show renames/moves as such
	renames = true
	# When using --word-diff, assume --word-diff-regex=.
	wordRegex = .
	# Display submodule-related information (commit listings)
	submodule = log
	# Use VSCode as default diff tool when running `git diff-tool`
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[fetch]
	# Auto-fetch submodule changes (sadly, won't auto-update)
	recurseSubmodules = on-demand
	prune = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[grep]
	break = true
	heading = true
	lineNumber = true
	# Consider most regexes to be ERE
	extendedRegexp = true
[pull]
	rebase = merges
[push]
	default = simple
	autoSetupRemote = true
[user]
	name = Yann Mainier
	# Never guess the identity: email must be set in ~/.gitconfig.local
	useConfigOnly = true
	# Default signing key; other machines override this in ~/.gitconfig.local
	signingKey = ~/.ssh/id_rsa.pub
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[init]
	defaultBranch = main
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[branch]
	sort = -committerdate

# Machine-specific overrides (email, signing key). Last, so it takes precedence.
[include]
	path = ~/.gitconfig.local
